<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nice Health Tab - RJW Genitalia  :  bootstrap assembly

    Build:   dotnet build -c Release
    Output:  ..\1.6\Assemblies\NHT_RJW_Genitalia.dll  (1.7 loads it through LoadFolders.xml)

    The game assemblies come from the Krafs.Rimworld.Ref NuGet package rather than from the
    installed game. RimWorld 1.7 dropped Unity: the managed folder is gone, the engine
    assemblies sit in the game root and the runtime is .NET 10 with UnityEngine redirected to
    UnityStubs (RimWorld.runtimeconfig.json), so no HintPath into the game folder survives.
    Building against 1.6 reference assemblies keeps one net472 dll that both versions load -
    the way RJW Gonadz Reloaded, a 1.7 mod, builds itself
    (refs/gonadz-reloaded-master/Source/Gonadz.csproj).
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>NHT_RJW_Genitalia</AssemblyName>
    <RootNamespace>NHTRJWGenitalia</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.2.0</Version>

    <!-- Pinned to UTF-8; the source files carry a BOM as well -->
    <CodePage>65001</CodePage>

    <!-- Build straight into the mod's Assemblies folder -->
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.7.2 reference assemblies, so this builds without Visual Studio -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      Harmony is referenced only. ExcludeAssets=runtime keeps 0Harmony.dll out of the
      output; the real 0Harmony is loaded by the Harmony mod (both NHT and RJW require
      brrainz.harmony as a hard dependency).
    -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      RimWorld and Unity reference assemblies. Reference only - nothing is copied into the
      output. NiceHediffTab.dll, the RJW assemblies and Cumpilation are deliberately not
      referenced at all: every patch against them goes through reflection.
    -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
